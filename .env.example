# Copy this file to .env and fill in real values.
# Never commit .env — it's already covered by .gitignore.

# --- Database (Neon Postgres) -----------------------------------------------
# Get this from your Neon project dashboard -> Connection Details.
DATABASE_URL=

# --- Auth: session signing (REQUIRED — the app will throw without this) -----
# Used to sign/verify the admin session token (HMAC-SHA256). Generate a
# long random value once, e.g.: openssl rand -base64 48
AUTH_SECRET=

# --- Auth: one-time admin account bootstrap ---------------------------------
# On first login attempt, if the users table is empty, an admin account is
# created using these values (password is hashed with PBKDF2 before
# storage — never stored or compared in plaintext). Not checked again once
# an account exists; safe to remove after your first successful login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Auth emails (Resend) ----------------------------------------------------
# Used for password-reset/username-recovery emails and the contact form's
# owner notification. Until RESEND_API_KEY is set, these are logged to the
# server console instead (see lib/email.ts), so the flows are fully testable
# before you have a Resend account.
# RESEND_API_KEY=
# Must be an address on a domain you've verified in your Resend dashboard
# (Resend rejects sends otherwise). Format: "Display Name <you@yourdomain.com>"
# RESEND_FROM_EMAIL=
# Where the contact form's "new inquiry" notification email is sent.
# ADMIN_EMAIL above is reused for this if set; this is only needed as a
# separate override.
# OWNER_EMAIL=

# --- Google OAuth (not yet wired in) -----------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Media (Vercel Blob) ------------------------------------------------------
# Required for the admin Media Library to work (upload/list/delete assets).
BLOB_READ_WRITE_TOKEN=
