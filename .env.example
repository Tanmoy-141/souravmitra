# Copy this file to .env and fill in real values.
# Never commit .env — it's already covered by .gitignore.

# --- Database (Neon Postgres) -----------------------------------------------
# Get this from your Neon project dashboard -> Connection Details.
DATABASE_URL=

# --- Auth: session signing (REQUIRED — the app will throw without this) -----
# Used to sign/verify the admin session token (HMAC-SHA256). Generate a
# long random value once, e.g.: openssl rand -base64 48
AUTH_SECRET=

# --- Auth: one-time admin account bootstrap ---------------------------------
# On first login attempt, if the users table is empty, an admin account is
# created using these values (password is hashed with PBKDF2 before
# storage — never stored or compared in plaintext). Not checked again once
# an account exists; safe to remove after your first successful login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Auth emails (Resend) ----------------------------------------------------
# Used for password-reset and username-recovery emails. Until this is set,
# those emails are logged to the server console instead (see lib/email.ts),
# so the flows are fully testable before you have a Resend account.
# RESEND_API_KEY=

# --- Google OAuth (not yet wired in) -----------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Media (Vercel Blob) ------------------------------------------------------
# Required for the admin Media Library to work (upload/list/delete assets).
BLOB_READ_WRITE_TOKEN=
