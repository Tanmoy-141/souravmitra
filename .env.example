# Copy this file to .env and fill in real values.
# Never commit .env — it's already covered by .gitignore.

# --- Current: temporary admin credentials -----------------------------------
# IMPORTANT: app/api/auth/route.ts falls back to hardcoded defaults
# (username "sourav", password "password123", recovery OTP "123456") if
# these are NOT set. That fallback is a real security risk on a public
# deployment — set these now, and treat this whole auth system as
# temporary scaffolding until Phase 2 (Auth.js) replaces it.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
RECOVERY_CODE=

# --- Phase 1: Database (Neon Postgres) -------------------------------------
# Get this from your Neon project dashboard -> Connection Details.
# Use the "pooled connection" string for the app; a direct connection also
# works fine with the HTTP driver used in db/index.ts.
DATABASE_URL=

# --- Phase 2: Auth (added later — listed here so the shape is visible now) -
# AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Phase 3: Media (Vercel Blob) -------------------------------------------
# BLOB_READ_WRITE_TOKEN=

# --- Auth emails (Resend) ---------------------------------------------------
# RESEND_API_KEY=
